{
  "name": "smvep-painel",
  "version": "0.1.0",
  "private": true,
  "description": "Recebe os ciclos de estacionamento que a API do host empurra por WebSocket e mostra no painel do SMVEP.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n receptor,web -c cyan,magenta \"npm:dev:receptor\" \"npm:dev:web\"",
    "dev:receptor": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run verificar && vite build",
    "start": "node server/index.ts",
    "test": "node --test \"server/**/*.test.ts\" \"shared/**/*.test.ts\"",
    "verificar": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^7",
    "ws": "^8.22.2"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4"
  }
}
